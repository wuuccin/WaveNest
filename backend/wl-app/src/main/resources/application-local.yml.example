# 个人本地配置模板（不入库）
#
# 用法：
#   cp backend/wl-app/src/main/resources/application-local.yml.example  backend/wl-app/application-local.yml
#   （Windows 用 copy）
# 文件名 application-local.yml 已被 .gitignore 忽略，改什么都不会被 git 看到。
#
# 作用：覆盖 application.yml 里的共享默认值。常见需要改的场景——
#   - 本机 3306/6379/5672/1883 端口被别的软件占用
#   - 本机 MySQL 是自己装的，口令与 compose 里的 wavenest 不同
#   - 演示时要从 sim profile 切到真实数据源
#
# 不写这个文件也能跑：application.yml 的默认值与 deploy/docker-compose.yml 一一对应。
# 下面的键全部按需启用（默认整段注释掉更安全）。

# server:
#   port: 8080

spring:
  # datasource:
  #   url: jdbc:mysql://127.0.0.1:3306/wavenest?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai
  #   username: root
  #   password: 换成你自己的口令
  # data:
  #   redis:
  #     host: 127.0.0.1
  #     port: 6379
  # rabbitmq:
  #   host: 127.0.0.1
  #   port: 5672
  #   username: guest
  #   password: guest
  profiles:
    active: sim

wavenest:
  mqtt:
    enabled: false
#   host: 127.0.0.1
#   port: 1883

logging:
  level:
    root: INFO
    com.waterlogistics: INFO
