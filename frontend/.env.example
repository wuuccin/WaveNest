# Default: Spring Boot backend. Keep local overrides in .env.local.
WAVENEST_BACKEND_URL=http://127.0.0.1:8080
# Only explicit offline selection enables mock frames.
VITE_DATA_SOURCE=live
VITE_SIM_SHIP_MMSI=123456789
# Obtain a browser key from Tianditu and allow your local development origin.
# Keep the actual key in .env.local; never commit it.
VITE_TIANDITU_KEY=
